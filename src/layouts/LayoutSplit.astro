---
import Profile from "@/components/Profile.astro"
import Skills from "@/components/Skills.astro"
---

<div class="block md:grid md:grid-cols-3 min-h-screen w-full">
    
    <div class="order-1 md:order-1 flex flex-col md:items-end md:sticky md:top-0 md:h-fit">
        <Profile/>
    </div>

    <div class="order-2 md:order-3 flex flex-col md:sticky md:top-0 md:h-fit">
        <Skills/>
    </div>

    <div class="order-3 md:order-2 p-4">
        <slot></slot>
    </div>
    
</div>