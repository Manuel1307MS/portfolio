---
import Layout from "@/layouts/Layout.astro";
import LayoutSplit from "@/layouts/LayoutSplit.astro";
import Post from "@/components/Post.astro";
import ImagePost from "@/components/ImagePost.astro";
import ProjectPost from "@/components/ProjectPost.astro";
import AdPost from "@/components/AdPost.astro";

import highschool from "@/assets/highschool.jpeg";
import universityofxalapa from "@/assets/universityofxalapa.jpeg";
import quicklearning from "@/assets/quicklearning.jpeg";

import bufonio from "@/assets/bufonio.jpeg";

import IconContainer from "@/components/IconContainer.astro";

import JavaIcon from "@/components/icons/JavaIcon.astro";
import SpringIcon from "@/components/icons/SpringIcon.astro";
import MySQLIcon from "@/components/icons/MySQLIcon.astro";
import PostgreSQLIcon from "@/components/icons/PostgreSQLIcon.astro";

import HTMLIcon from "@/components/icons/HTMLIcon.astro";
import CSSIcon from "@/components/icons/CSSIcon.astro";
import JavaScriptIcon from "@/components/icons/JavaScriptIcon.astro";
import ReactIcon from "@/components/icons/ReactIcon.astro";
import AstroIcon from "@/components/icons/AstroIcon.astro";

import TypeScriptIcon from "@/components/icons/TypeScriptIcon.astro";
import TailwindIcon from "@/components/icons/TailwindIcon.astro";

import GitIcon from "@/components/icons/GitIcon.astro";
import GitHubIcon from "@/components/icons/GitHubIcon.astro";
import DockerIcon from "@/components/icons/DockerIcon.astro";
import CloudflareIcon from "@/components/icons/CloudflareIcon.astro";
import VercelIcon from "@/components/icons/VercelIcon.astro";
import RenderIcon from "@/components/icons/RenderIcon.astro";
import SupabaseIcon from "@/components/icons/SupabaseIcon.astro";

const dataAds = [
  {
    title: "Ad",
    description:
      "Every great product starts with an idea, let's create yours together.",
    category: "education",
    adTitle: "This spot is reserved for you",
    message: "Tell me your vision.",
  },
  {
    title: "Ad",
    description:
      "Let's build a digital product that stands out and delivers real results.",
    category: "projects",
    adTitle: "Your project could be next",
    message: "Let's talk about your idea.",
  },
];

const dataProjects = [
  {
    title: "Bufonio",
    description:
      "Bufonio is an anonymous feedback platform that uses artificial intelligence to turn employee feedback into constructive messages with a touch of humor, fostering more open communication and reducing tension between teams and leaders.",
    category: "projects",
  },
];

const dataEducation = [
  {
    title: "High school",
    description:
      "My training as a high school graduate with a technical degree in computer science was the starting point for discovering my interest in programming and technology.",
    category: "education",
  },
  {
    title: "University of Xalapa",
    description:
      "With the goal of designing software solutions that meet business needs, I decided to study International Business to gain strategic knowledge of trade, finance, and management.",
    category: "education",
  },
  {
    title: "Quick Learning",
    description:
      "To expand my professional profile, I studied English at Quick Learning, where I achieved a B1 level, which allows me to communicate fluently in a variety of situations.",
    category: "education",
  },
];

const dataSkills = [
  {
    title: "Backend",
    description:
      "Driven by curiosity, I studied Java and developed my first applications while learning the fundamentals of software development. I then delved deeper into Spring and SQL, which allowed me to advance my training as a backend developer.",
    category: "skills",
  },
  {
    title: "Frontend",
    description:
      "Looking to strengthen my profile as a developer, I began learning front-end development, gaining knowledge in HTML, CSS, and JavaScript, as well as modern frameworks such as React and Astro.",
    category: "skills",
  },
  {
    title: "Frontend",
    description:
      "As part of my growth as a front-end developer, I integrated TypeScript and Tailwind CSS into my projects, improving code quality and enabling me to build modern, scalable, and well-structured interfaces.",
    category: "skills",
  },
  {
    title: "Platforms",
    description:
      "To continue strengthening my tech stack, I've learned various tools and platforms that help me develop my projects.",
    category: "skills",
  },
];
---

<Layout>
  <nav
    class="bg-white border-b border-black/20 h-14 flex items-center justify-center gap-1 md:gap-4 sticky top-0 z-10 px-4"
  >
    <button
      data-filter="all"
      class="w-20 md:w-24 text-black cursor-pointer font-bold text-base"
      >Home</button
    >
    <button
      data-filter="projects"
      class="w-20 md:w-24 text-black/80 cursor-pointer font-normal text-base"
      >Projects</button
    >
    <button
      data-filter="education"
      class="w-20 md:w-24 text-black/80 cursor-pointer font-normal text-base"
      >Education</button
    >
    <button
      data-filter="skills"
      class="w-20 md:w-24 text-black/80 cursor-pointer font-normal text-base"
      >Skills</button
    >
  </nav>

  <LayoutSplit>
    <div id="feed-container" class="flex flex-col gap-4 scroll-mt-18">
      <Post
        title={dataSkills[3].title}
        description={dataSkills[3].description}
        category={dataSkills[3].category}
      >
        <div class="flex flex-wrap justify-center gap-10">
          <IconContainer figcaption="Git">
            <GitIcon width="50" height="50" />
          </IconContainer>
          <IconContainer figcaption="GitHub">
            <GitHubIcon width="50" height="50" />
          </IconContainer>
          <IconContainer figcaption="Docker">
            <DockerIcon width="50" height="50" />
          </IconContainer>
          <IconContainer figcaption="Cloudflare">
            <CloudflareIcon width="50" height="50" />
          </IconContainer>
          <IconContainer figcaption="Vercel">
            <VercelIcon width="50" height="50" />
          </IconContainer>
          <IconContainer figcaption="Render">
            <RenderIcon width="50" height="50" />
          </IconContainer>
          <IconContainer figcaption="Supabase">
            <SupabaseIcon width="50" height="50" />
          </IconContainer>
        </div>
      </Post>
      <ProjectPost
        title={dataProjects[0].title}
        description={dataProjects[0].description}
        category={dataProjects[0].category}
        src={bufonio}
        alt="Bufonio"
        urlBackend="https://github.com/Manuel1307MS/bufonio"
        urlFrontend="https://github.com/Manuel1307MS/bufonio-landing"
        urlLive="https://bufonio.vercel.app"
      />
      <AdPost
        title={dataAds[1].title}
        description={dataAds[1].description}
        category={dataAds[1].category}
        adTitle={dataAds[1].adTitle}
        message={dataAds[1].message}
      />
      <Post
        title={dataSkills[2].title}
        description={dataSkills[2].description}
        category={dataSkills[2].category}
      >
        <div class="flex flex-wrap justify-center gap-10">
          <IconContainer figcaption="TypeScript">
            <TypeScriptIcon width="50" height="50" />
          </IconContainer>
          <IconContainer figcaption="Tailwind">
            <TailwindIcon width="50" height="50" />
          </IconContainer>
        </div>
      </Post>
      <ImagePost
        title={dataEducation[2].title}
        description={dataEducation[2].description}
        category={dataEducation[2].category}
        src={quicklearning}
        alt="Quick Learning"
      />
      <Post
        title={dataSkills[1].title}
        description={dataSkills[1].description}
        category={dataSkills[1].category}
      >
        <div class="flex flex-wrap justify-center gap-10">
          <IconContainer figcaption="HTML">
            <HTMLIcon width="50" height="50" />
          </IconContainer>
          <IconContainer figcaption="CSS">
            <CSSIcon width="50" height="50" />
          </IconContainer>
          <IconContainer figcaption="JavaScript">
            <JavaScriptIcon width="50" height="50" />
          </IconContainer>
          <IconContainer figcaption="React">
            <ReactIcon width="50" height="50" />
          </IconContainer>
          <IconContainer figcaption="Astro">
            <AstroIcon width="50" height="50" />
          </IconContainer>
        </div>
      </Post>
      <ImagePost
        title={dataEducation[1].title}
        description={dataEducation[1].description}
        category={dataEducation[1].category}
        src={universityofxalapa}
        alt="University of Xalapa"
      />
      <Post
        title={dataSkills[0].title}
        description={dataSkills[0].description}
        category={dataSkills[0].category}
      >
        <div class="flex flex-wrap justify-center gap-10">
          <IconContainer figcaption="Java">
            <JavaIcon width="50" height="50" />
          </IconContainer>
          <IconContainer figcaption="Spring">
            <SpringIcon width="50" height="50" />
          </IconContainer>
          <IconContainer figcaption="MySQL">
            <MySQLIcon width="50" height="50" />
          </IconContainer>
          <IconContainer figcaption="PostgreSQL">
            <PostgreSQLIcon width="50" height="50" />
          </IconContainer>
        </div>
      </Post>
      <AdPost
        title={dataAds[0].title}
        description={dataAds[0].description}
        category={dataAds[0].category}
        adTitle={dataAds[0].adTitle}
        message={dataAds[0].message}
      />
      <ImagePost
        title={dataEducation[0].title}
        description={dataEducation[0].description}
        category={dataEducation[0].category}
        src={highschool}
        alt="High school"
      />
    </div>
  </LayoutSplit>
</Layout>

<script>
  const items = document.querySelectorAll(
    ".filter-item",
  ) as NodeListOf<HTMLElement>;
  const buttons = document.querySelectorAll(
    "[data-filter]",
  ) as NodeListOf<HTMLElement>;
  const feedContainer = document.getElementById("feed-container");

  const runFilter = (value: string | null) => {
    buttons.forEach((btn) => {
      const active = btn.getAttribute("data-filter") === value;
      btn.classList.toggle("text-black", active);
      btn.classList.toggle("font-bold", active);
      btn.classList.toggle("text-base", active);
      btn.classList.toggle("text-black/80", !active);
      btn.classList.toggle("font-normal", !active);
      btn.classList.toggle("text-base", !active);
    });

    items.forEach((item) =>
      item.classList.toggle(
        "hidden",
        value !== "all" && value !== item.getAttribute("data-category"),
      ),
    );

    if (value === "all") {
      window.scrollTo({ top: 0, behavior: "smooth" });
    } else {
      feedContainer?.scrollIntoView({ behavior: "smooth", block: "start" });
    }
  };

  buttons.forEach((btn) =>
    btn.addEventListener("click", () =>
      runFilter(btn.getAttribute("data-filter")),
    ),
  );
</script>
