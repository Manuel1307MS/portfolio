---
interface Props {
    title: string;
    description: string;
    category: string;
}

const { title, description, category } = Astro.props;
---

<div data-category={category} class="filter-item">
    <h2 class="font-semibold p-1">{title}</h2>
    <slot />
    <p class="text-sm text-black/80 p-1">{description}</p>
</div>