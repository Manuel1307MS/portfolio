---
import HeartIcon from "@/components/icons/HeartIcon.astro";
import ShareIcon from "@/components/icons/ShareIcon.astro";
import Badge from "./Badge.astro";

interface Props {
  title: string;
  description: string;
  category: string;
  topic: string;
}

const { title, description, category, topic } = Astro.props;
---

<div
  data-category={category}
  class="filter-item flex flex-col border border-black/10 p-4 gap-4"
>
  <div class="flex items-center justify-between">
    <h2 class="font-semibold">{title}</h2>
    <Badge text={topic} />
  </div>
  <div class="">
    <slot />
  </div>
  <div class="flex gap-2">
    <HeartIcon width="28" height="28" />
    <ShareIcon width="28" height="28" />
  </div>
  <p class="text-sm text-black/80">{description}</p>
</div>
