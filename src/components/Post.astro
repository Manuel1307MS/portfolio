---
import HeartIcon from "@/components/icons/HeartIcon.astro";
import ShareIcon from "@/components/icons/ShareIcon.astro";

interface Props {
  title: string;
  description: string;
  category: string;
}

const { title, description, category } = Astro.props;
---

<div data-category={category} class="filter-item border-b border-black/20">
  <h2 class="font-semibold p-2">{title}</h2>
  <slot />
  <div class="flex gap-1 p-2">
    <HeartIcon width="28" height="28" />
    <ShareIcon width="28" height="28" />
  </div>
  <p class="text-sm text-black/80 p-2">{description}</p>
</div>
