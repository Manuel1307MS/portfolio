---
import type { ComponentProps } from "astro/types";
import Post from "@/components/Post.astro";
import ImageContainer from "@/components/ImageContainer.astro";
import IconContainer from "@/components/IconContainer.astro";
import GitHubIcon from "@/components/icons/GitHubIcon.astro";
import ExternalLinkIcon from "@/components/icons/ExternalLinkIcon.astro";

interface Props extends ComponentProps<typeof Post> {
  src: ImageMetadata;
  alt: string;
  urlBackend?: string;
  urlFrontend?: string;
  urlLive?: string;
}

const { src, alt, urlBackend, urlFrontend, urlLive, ...postProps } =
  Astro.props;
---

<Post {...postProps}>
  <div class="flex flex-col items-center gap-4">
    <ImageContainer src={src} alt={alt} />
    <div class="flex gap-8">
      <a href={urlBackend} target="_blank" rel="noopener noreferrer"
        ><IconContainer figcaption="Backend">
          <GitHubIcon width="28" height="28" />
        </IconContainer>
        <a href={urlFrontend} target="_blank" rel="noopener noreferrer"
          ><IconContainer figcaption="Frontend">
            <GitHubIcon width="28" height="28" />
          </IconContainer></a
        >
        <a href={urlLive} target="_blank" rel="noopener noreferrer"
          ><IconContainer figcaption="Live">
            <ExternalLinkIcon width="28" height="28" />
          </IconContainer></a
        >
      </a>
    </div>
  </div>
</Post>
