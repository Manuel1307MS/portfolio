---
import type { IconProps } from "@/components/icons/IconProps";
const { width = 24, height = 24 } = Astro.props as IconProps;
---

<label
  class="cursor-pointer inline-block transition-transform duration-200 hover:scale-110"
>
  <input type="checkbox" class="peer hidden" />
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width={width}
    height={height}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="text-black peer-checked:fill-red-500 peer-checked:stroke-red-500 peer-checked:text-red-500"
  >
    <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
    <path
      d="M19.5 12.572l-7.5 7.428l-7.5 -7.428a5 5 0 1 1 7.5 -6.566a5 5 0 1 1 7.5 6.572"
    ></path>
  </svg>
</label>
