---
import Badge from "@/components/Badge.astro";
---

<div class="flex flex-col gap-4 w-full md:w-70">
    <div class="flex flex-col gap-4 border border-black/10 p-4">
        <h2 class="font-semibold">Technologies</h2>
        <div class="flex flex-col gap-1">
            <h3 class="text-sm font-semibold">Backend</h3>
            <div class="flex flex-wrap gap-2">
                <Badge text="Java" />
                <Badge text="Spring Boot" />
                <Badge text="MySQL" />
                <Badge text="PostgreSQL" />
            </div>
        </div>
        <div class="flex flex-col gap-1">
            <h3 class="text-sm font-semibold">Frontend</h3>
            <div class="flex flex-wrap gap-2">
                <Badge text="HTML" />
                <Badge text="CSS" />
                <Badge text="JavaScript" />
                <Badge text="React" />
                <Badge text="Astro" />
                <Badge text="TypeScript" />
                <Badge text="Tailwind" />
            </div>
        </div>
        <div class="flex flex-col gap-1">
            <h3 class="text-sm font-semibold">Tools</h3>
            <div class="flex flex-wrap gap-2">
                <Badge text="Git" />
                <Badge text="GitHub" />
                <Badge text="Turborepo" />
                <Badge text="Docker" />
                <Badge text="Hoppscotch" />
                <Badge text="Supabase" />
                <Badge text="Vercel" />
                <Badge text="Render" />
                <Badge text="Cloudflare" />
            </div>
        </div>
    </div>
    <div class="flex flex-col gap-4 border border-black/10 p-4">
        <h2 class="font-semibold">Interests</h2>
        <div class="flex flex-wrap gap-2">
            <Badge text="Technology" />
            <Badge text="Programming" />
            <Badge text="Innovation" />
            <Badge text="Business" />
            <Badge text="Artificial Intelligence" />
            <Badge text="Languages" />
            <Badge text="Art" />
        </div>
    </div>
</div>
