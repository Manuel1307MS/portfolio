---
import GmailIcon from "@/components/icons/GmailIcon.astro";
import GitHubIcon from "@/components/icons/GitHubIcon.astro";
---

<div class="flex flex-col items-center gap-6 w-full md:w-70">
  <h1 class="font-black text-2xl tracking-tighter text-center">
    MANUEL MURILLO
  </h1>
  <div class="flex flex-col items-center gap-1 font-semibold text-center">
    <h2>Java Backend Developer</h2>
    <p>Mexico</p>
  </div>
  <div class="flex items-center gap-8">
    <button
      data-copy-email="manuel1307ms@gmail.com"
      aria-label="Copy email"
      title="Copy email"
      class="cursor-pointer"
    >
      <GmailIcon width="30" height="30" />
    </button>
    <a
      href="https://github.com/Manuel1307MS"
      target="_blank"
      aria-label="GitHub"
      title="GitHub"
    >
      <GitHubIcon width="28" height="28" />
    </a>
  </div>
  <p class="text-sm text-black/80 text-justify">
    Java backend developer with business knowledge, focused on designing
    solutions that optimize processes and drive results.
  </p>
</div>

<script>
  const setupCopyEmail = () => {
    const button =
      document.querySelector<HTMLButtonElement>("[data-copy-email]");
    if (!button) return;

    button.addEventListener("click", async () => {
      const email = button.getAttribute("data-copy-email");
      if (!email) return;

      try {
        await navigator.clipboard.writeText(email);
        window.dispatchEvent(
          new CustomEvent("show-toast", {
            detail: { message: "Email copied to clipboard" },
          }),
        );
      } catch {
        window.dispatchEvent(
          new CustomEvent("show-toast", {
            detail: { message: "Failed to copy email", isError: true },
          }),
        );
      }
    });
  };

  setupCopyEmail();
  document.addEventListener("astro:page-load", setupCopyEmail);
</script>
