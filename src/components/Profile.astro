---
import GmailIcon from "@/components/icons/GmailIcon.astro"
import GitHubIcon from "@/components/icons/GitHubIcon.astro"
---

<div class="flex flex-col items-center gap-6 p-6 w-full md:w-70">
    <h1 class="font-extrabold text-2xl tracking-tighter text-center">
        MANUEL MURILLO
    </h1>
    <div class="flex flex-col items-center gap-1">
        <h2 class="font-semibold text-center">
            Java Backend Developer
        </h2>
        <p class="font-semibold text-center">
            México
        </p>
    </div>
    <div class="flex items-center gap-8">
        <GmailIcon height="30" width="30"/>
        <GitHubIcon height="28" width="28"/>
    </div>
    <p class="text-sm text-black/80 text-justify">
        Java backend developer with business knowledge, focused on designing solutions that optimize processes and drive results.
    </p>
</div>